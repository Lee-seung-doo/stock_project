# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 git 에 올라가지 않는다.

# 데이터베이스 파일 위치
STOCKPROJ_DB_PATH=data/stock.duckdb

# KRX 정보데이터시스템 계정 (필수, https://data.krx.co.kr 무료 회원가입)
# pykrx 가 국내 종목 목록과 일봉을 받을 때 로그인에 쓴다.
KRX_ID=
KRX_PW=

# 토스증권 Open API (토스증권 WTS > 설정 > Open API 에서 발급, 허용 IP 등록 필요)
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_BASE_URL=https://openapi.tossinvest.com

# OpenDART (https://opendart.fss.or.kr 에서 무료 발급)
DART_API_KEY=

# SEC EDGAR 는 키가 없지만 User-Agent 에 앱 이름과 연락처를 넣어야 한다.
# 예: "stockproj 본인이메일@example.com"
SEC_USER_AGENT=

# 카카오톡 나에게 보내기 (https://developers.kakao.com 에서 앱 생성)
# 앱 키 > REST API 키, 카카오 로그인 활성화, Redirect URI 등록, 동의항목 '카카오톡 메시지 전송' 사용
KAKAO_REST_API_KEY=
# 카카오 로그인 > 보안 > Client Secret 을 켰을 때만
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://localhost

# 카카오톡 메시지의 버튼이 열 대시보드 주소
DASHBOARD_URL=http://localhost:8501
